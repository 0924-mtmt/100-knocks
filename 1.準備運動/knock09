import random

def shuffle_inner_chars(word: str) -> str:
    if len(word) <= 4:
        return word

    first = word[0]
    last = word[-1]
    middle = list(word[1:-1])

    original_middle = middle[:]
    for _ in range(10):
        random.shuffle(middle)
        if middle != original_middle:
            break

    return first + "".join(middle) + last


def shuffle_sentence(text: str) -> str:
    words = text.split(" ")
    return " ".join(shuffle_inner_chars(w) for w in words)


sample_text = (
    "I couldn't believe that I could actually understand what I was reading "
    ": the phenomenal power of the human mind ."
)

print("元の文:")
print(sample_text)
print("\n変換後:")
print(shuffle_sentence(sample_text))
